
# Database — Neon PostgreSQL (required)
# Create a project at https://neon.tech → copy the pooled connection string.
# Run migrations against it: pnpm --filter web db:migrate (dev) / prisma migrate deploy (prod)
# Seed learning tracks:      pnpm --filter web db:seed
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth — authentication core (required)
# Generate a strong secret:  openssl rand -base64 32
#   (PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# LOCAL value: http://localhost:3000
# PRODUCTION value MUST be your deployed URL, e.g. https://your-app.vercel.app
#  — a localhost value in production causes redirect_uri_mismatch errors.

NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (required for "Continue with GitHub")
# Create at https://github.com/settings/developers (New OAuth App) — or
# https://github.com/settings/apps for a GitHub App (IDs starting "Ov23li").
# Register these exact callback URL(s):
#   Production: https://YOUR-DOMAIN/api/auth/callback/github
#   Local dev:  http://localhost:3000/api/auth/callback/github
# The Client Secret is shown once — copy it immediately.

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth (required for "Continue with Google")
# 1. Create a project at https://console.cloud.google.com
# 2. APIs & Services → OAuth consent screen → configure → Publish to Production
#    (Testing mode blocks every account except allowlisted test users)
# 3. Credentials → Create Credentials → OAuth client ID → Web application
#    Authorized JavaScript origins:
#       http://localhost:3000
#       https://YOUR-DOMAIN
#    Authorized redirect URIs:
#       http://localhost:3000/api/auth/callback/google
#       https://YOUR-DOMAIN/api/auth/callback/google

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenRouter — LLM features: quiz generation, defend sessions (required for AI)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
LLM_MODEL="google/gemini-2.0-flash-001"
LLM_MAX_TOKENS="4096"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="UnVibe"

# OPTIONAL — Cloudflare R2 storage.
# No application code consumes these yet; reserved for snapshots/PDF uploads.
# Create at https://dash.cloudflare.com → R2 → Manage API tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="unvibe-assets"

# OPTIONAL — Resend email service.
# No application code consumes this yet. Key at https://resend.com/api-keys
RESEND_API_KEY="re_..."

# OPTIONAL — PostHog product analytics.
# No application code consumes this yet. Key at https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY="phc_..."

# OPTIONAL — Judge0 self-hosted code execution sandbox.
# Only needed for the judge0.execute API route. Start locally with:
#   docker compose -f infra/docker-compose.yml up -d
JUDGE0_URL="http://localhost:2358"
