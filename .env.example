# Database configuration (PostgreSQL)
# Local: postgresql://user:password@localhost:5432/unvibe
# Production: Use your cloud provider connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/unvibe?schema=public"

# Redis cache and queue
# Local: redis://localhost:6379
# Production: Upstash Redis connection string
REDIS_URL="redis://localhost:6379"

# NextAuth authentication config
NEXTAUTH_SECRET="some-very-secure-random-secret-key-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Auth Providers OAuth credentials
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID="github_client_id_placeholder"
GITHUB_CLIENT_SECRET="github_client_secret_placeholder"

# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="google_client_id_placeholder"
GOOGLE_CLIENT_SECRET="google_client_secret_placeholder"

# AI services — OpenRouter (unified access to 200+ models)
# Get your key: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."
LLM_MODEL="google/gemini-2.0-flash-001"
LLM_MAX_TOKENS="4096"

# OpenRouter metadata (for model rankings)
OPENROUTER_SITE_URL="https://unvibe-omnikon.vercel.app"
OPENROUTER_APP_NAME="UnVibe"

# Cloudflare R2 Storage (for code snapshots and PDF reports)
# Create bucket: https://dash.cloudflare.com → R2
R2_ACCOUNT_ID="r2_account_id_placeholder"
R2_ACCESS_KEY_ID="r2_access_key_id_placeholder"
R2_SECRET_ACCESS_KEY="r2_secret_access_key_placeholder"
R2_BUCKET_NAME="unvibe-assets"

# Email service (Resend for welcome emails, notifications)
# Get key: https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Sentry application monitoring
# Create project: https://sentry.io
SENTRY_DSN_API="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_DSN_WEB="https://examplePublicKey@o0.ingest.sentry.io/0"

# API URL for web (Vercel proxy to backend)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# PostHog analytics (product usage tracking)
# Get key: https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY="phc_..."

# CORS origin (for local development)
CORS_ORIGIN="http://localhost:3000"

# Judge0 API (for code execution sandboxing)
JUDGE0_URL="http://localhost:2358"
